<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="baseline" value="0.12"/>  <!-- 120mm stereo baseline -->

  <xacro:macro name="zed_camera" params="name parent x y z roll pitch yaw">

    <!-- Camera body -->
    <link name="${name}_frame">
      <inertial>
        <mass value="0.17"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${parent}_to_${name}" type="fixed">
      <parent link="${parent}"/>
      <child  link="${name}_frame"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>

    <!-- Left lens (optical frame: z-forward, x-right, y-down) -->
    <link name="${name}_left_frame"/>
    <joint name="${name}_to_left" type="fixed">
      <parent link="${name}_frame"/>
      <child  link="${name}_left_frame"/>
      <origin xyz="0 ${baseline/2} 0" rpy="0 0 0"/>
    </joint>

    <!-- Right lens -->
    <link name="${name}_right_frame"/>
    <joint name="${name}_to_right" type="fixed">
      <parent link="${name}_frame"/>
      <child  link="${name}_right_frame"/>
      <origin xyz="0 ${-baseline/2} 0" rpy="0 0 0"/>
    </joint>

    <!-- Depth/IMU frame (center of baseline) -->
    <link name="${name}_depth_frame"/>
    <joint name="${name}_to_depth" type="fixed">
      <parent link="${name}_frame"/>
      <child  link="${name}_depth_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
